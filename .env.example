# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# Never commit real values (the repo is public). README.md → "Environment variables" has the
# Vercel table (which ones are Sensitive, which environments).

# Supabase → Project Settings → Data API (URL) and API Keys (anon / publishable key).
# Public by design: these two are built into the browser code. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only (bookings, staff emails, /staff). Never prefix with NEXT_PUBLIC_. Sensitive.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Emails (Resend): salon copy, customer confirmation, and the assigned barber/stylist
# (address from staff.email in the database; .invalid placeholders are skipped).
# Bookings still work if these are missing or sending fails. Sensitive.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where the salon copy goes (default: freshlook.Ottawa@gmail.com)
SALON_NOTIFY_EMAIL=freshlook.Ottawa@gmail.com
# Optional sender. Unset = "Fresh Look <onboarding@resend.dev>", which Resend ONLY delivers
# to the Resend account owner's own address: customers and staff get nothing.
# Verify a domain in Resend (Domains → Add → DNS records), then set e.g.
# RESEND_FROM="Fresh Look <bookings@yourdomain.ca>"
RESEND_FROM=

# Who can open /staff (comma-separated, case-insensitive). Everyone else is refused.
STAFF_EMAILS=owner@example.com,barber.a@example.com

# Optional: run the live Supabase RLS tests (npm test) against the real project.
# LIVE_SUPABASE_TESTS=1
