# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# Never commit real values (the repo is public).

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Phase 3 (emails). Bookings work without these.
RESEND_API_KEY=
SALON_EMAIL=freshlook.Ottawa@gmail.com
